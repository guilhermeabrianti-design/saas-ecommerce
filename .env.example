# =====================================================================
# TheSigns — environment template
# Copy to `.env.local` (frontend) and set server secrets via
# `supabase secrets set` (Edge Functions). NEVER commit real values.
# See ENVIRONMENT.md for details.
# =====================================================================

# ---------------------------------------------------------------------
# FRONTEND (public — exposed to the browser, prefixed with VITE_)
# Only the anon key belongs here. It is safe ONLY because RLS is enforced.
# ---------------------------------------------------------------------
VITE_APP_ENV=development
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# SERVER-SIDE ONLY (Supabase Edge Function secrets)
# NEVER prefix these with VITE_. NEVER reference them in src/.
# ---------------------------------------------------------------------
APP_ENV=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Symmetric key used to encrypt marketplace credentials at rest (32 bytes, base64)
CREDENTIALS_ENCRYPTION_KEY=

# AI
OPENAI_API_KEY=

# Marketplaces
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
WOOCOMMERCE_CLIENT_ID=
WOOCOMMERCE_CLIENT_SECRET=

# Payments: Mercado Pago (Fase 21). Use as credenciais de TESTE fora de produção.
# A URL de notificações é <SUPABASE_URL>/functions/v1/checkout/webhook (painel do
# Mercado Pago → Suas integrações → Webhooks → evento "Pagamentos"); a chave secreta
# exibida lá é o MERCADOPAGO_WEBHOOK_SECRET.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
